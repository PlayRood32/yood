{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "removeComments": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
